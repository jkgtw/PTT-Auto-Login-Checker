# ============================================================
# PTT Auto Login Checker - example environment file
#
# Copy:
#   cp .env.example .ptt-check.env
#   chmod 600 .ptt-check.env
#
# NEVER commit the real .ptt-check.env to GitHub.
# ============================================================

# ------------------------------------------------------------
# Multi-account mode (recommended)
# ------------------------------------------------------------

# Number of PTT accounts. Supported range: 1-10.
PTT_ACCOUNT_COUNT='2'

# Account 1
PTT_ACCOUNT_1='your_ptt_id_1'
PTT_PASSWORD_1='your_ptt_password_1'

# Optional friendly name used in logs / Telegram.
PTT_ACCOUNT_LABEL_1='Main'

# Optional PTT TOTP Base32 secret. Leave blank if 2FA is disabled
# or this login does not require a 2FA challenge.
PTT_TOTP_SECRET_1=''

# Optional 8-digit PTT recovery code. Prefer TOTP when possible.
PTT_2FA_RECOVERY_CODE_1=''

# Account 2
PTT_ACCOUNT_2='your_ptt_id_2'
PTT_PASSWORD_2='your_ptt_password_2'
PTT_ACCOUNT_LABEL_2='Alt'
PTT_TOTP_SECRET_2=''
PTT_2FA_RECOVERY_CODE_2=''

# Add PTT_ACCOUNT_3 / PTT_PASSWORD_3 / ... as needed.
# Maximum: 10 accounts.

# Delay between accounts, in seconds. Sequential login is used.
PTT_ACCOUNT_DELAY='1'

# ------------------------------------------------------------
# Legacy single-account mode
#
# If you prefer the old format, REMOVE/COMMENT all PTT_ACCOUNT_n
# settings above, including PTT_ACCOUNT_COUNT, and use:
# ------------------------------------------------------------
# PTT_ACCOUNT='your_ptt_id'
# PTT_PASSWORD='your_ptt_password'
# PTT_ACCOUNT_LABEL='Main'
# PTT_TOTP_SECRET=''
# PTT_2FA_RECOVERY_CODE=''

# ------------------------------------------------------------
# PTT 2FA global behavior
# ------------------------------------------------------------

# Script-side maximum attempts if PTT asks for 2FA.
PTT_2FA_MAX_ATTEMPTS='2'

# ------------------------------------------------------------
# Telegram Bot (required)
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN='123456789:replace_with_your_bot_token'
TELEGRAM_CHAT_ID='123456789'

# Optional Telegram topic / thread ID.
TELEGRAM_MESSAGE_THREAD_ID=''

# 1 = silent notification, 0 = normal notification.
TELEGRAM_SILENT='0'

# 1 = do not call Telegram API; print the message instead.
TELEGRAM_DRY_RUN='0'

# ------------------------------------------------------------
# Display name shown in Telegram
# ------------------------------------------------------------

# If blank, the OS hostname is used.
SERVER_NAME='My PTT Server'

# ------------------------------------------------------------
# PTT connection
# ------------------------------------------------------------
PTT_HOST='ptt.cc'
PTT_PORT='22'
PTT_CONNECT_TIMEOUT='15'
PTT_SESSION_TIMEOUT='75'

# 1 = answer yes when PTT asks about duplicate login handling.
# 0 = keep the other session.
PTT_KICK_DUPLICATE='0'

# ------------------------------------------------------------
# Exact P-coin retry
#
# If PTT self-query does not yet show ($12345), retry after the
# following delays. Up to 3 delay values are accepted.
# ------------------------------------------------------------
PTT_MONEY_RETRY_DELAYS='1,2'

# Legacy retry settings are also supported if the line above is absent:
# PTT_MONEY_RETRY_COUNT='1'
# PTT_MONEY_RETRY_DELAY='2'

# ------------------------------------------------------------
# Local logs
# ------------------------------------------------------------
PTT_LOG_DIR='/home/ubuntu/dockerdata/autoptt'

# history.jsonl: when larger than MAX, retain newest KEEP MiB.
PTT_HISTORY_MAX_MB='10'
PTT_HISTORY_KEEP_MB='5'

# last-debug.txt maximum size.
PTT_DEBUG_MAX_MB='2'

# ------------------------------------------------------------
# Runtime environment
# ------------------------------------------------------------
TZ='Asia/Taipei'
PATH='/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin'
